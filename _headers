# Cloudflare Pages — cabeçalhos HTTP
# Bloqueia a indexação dos endereços provisórios *.pages.dev (produção e previews),
# evitando conteúdo duplicado com o domínio oficial kellycorreaneuro.com.br.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Cache longo para ativos estáticos (fontes, imagens, vídeo)
/assets/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/assets/videos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Segurança básica para todas as páginas
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Arquivos para robôs e IAs com cache curto
/llms.txt
  Content-Type: text/plain; charset=utf-8
